# Build output
dist/
build/

# Optional npm cache directory
.npm/

# Optional eslint cache
.eslintcache

# dotenv environment variables file
.env
.env.local
.env.*.local
config.json

# 工作区临时产物（探针脚本 / 日志 / 样本 / DB 导出）
tmp/

# Mac system files
.DS_Store

# IDE files
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
